# lib/aor LLM configuration
# Copy this file to .env and fill in the values.
#   cp lib/aor/.env.example lib/aor/.env

# LLM provider: anthropic | openai | sfdc_gateway | local
LLM_PROVIDER=open_ai

# Model ID for the chosen provider
LLM_MODEL=claude-sonnet-4-5-20250929

# API key for the chosen provider.
#   sfdc_gateway → paste your EDC_GATEWAY_API_KEY value here
#   anthropic    → paste your Anthropic API key here
#   openai       → paste your OpenAI API key here
#   local        → leave blank
LLM_API_KEY=

# Arize Phoenix tracing (fully local, no account needed).
# Start Phoenix: uv run python -m phoenix.server.main serve
# View traces:   http://localhost:6006
# Set to true to enable; false (default) means no tracing overhead.
PHOENIX_TRACING=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Default cost budget in USD (applies to all packs).
# The skill will ask the user at runtime; this is the fallback if they skip.
MAX_COST_USD=1.00
